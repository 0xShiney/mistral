---
import { ClientRouter } from 'astro:transitions'
import '../styles/base.css'
import '../styles/page.css'
import GlobalNavigation from '../components/GlobalNavigation.astro'

import { ORIGIN } from '../content/routes'

interface Props {
  title?: string
  description?: string
  /** Route path of this page, used for canonical/alternate/og:url. */
  path?: string
  /** Page-level structured data; defaults to the homepage's organization graph. */
  jsonLd?: Record<string, unknown>
  /** Social card URL; only pages whose original ships its own thumbnail pass one. */
  image?: string
  /** Declared dimensions of that card. */
  imageWidth?: string
  imageHeight?: string
  /** Route path of the nav item that is current on this page. */
  navActive?: string
  /** Header surface; the original uses `secondary` on /research/. */
  navSurface?: 'primary' | 'secondary'
}

const {
  title = 'Mistral | #1 in Sovereign AI: Frontier Open Models You Own',
  description = 'Mistral AI builds frontier open-weight models you own. Customize with Forge, deploy agents with Studio, run on-prem, your VPC, or our European sovereign cloud.',
  path = '/',
  jsonLd,
  image = 'https://mistral.ai/cms-media/api/media/file/cover-mistral-sovereign%20copie.webp',
  imageWidth = '1200',
  imageHeight = '630',
  navActive = '',
  navSurface = 'primary',
} = Astro.props
const canonical = ORIGIN + path
---

<!doctype html>
<html lang="en" class transition:animate="none" transition:name="root">
  <head>
    <meta charset="UTF-8" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="preload" href="/fonts/alt-mistral/ALTMistral-Medium.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="en" href={canonical} />
    <link rel="alternate" hreflang="fr" href={ORIGIN + '/fr' + path} />
    <link rel="alternate" hreflang="it" href={ORIGIN + '/it' + path} />
    <link rel="alternate" hreflang="x-default" href={canonical} />
    <link rel="alternate" type="application/rss+xml" title="Mistral" href="https://mistral.ai/news/rss" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Mistral" />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content={imageWidth} />
    <meta property="og:image:height" content={imageHeight} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    <meta name="viewport" content="width=device-width, height=device-height, initial-scale=1.0, minimum-scale=1.0" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd ?? {
      "@graph": [
        {
          "@id": "https://mistral.ai/#organization",
          url: "https://mistral.ai/",
          logo: "https://mistral.ai/images/logos/logo-mistral.svg",
          name: "Mistral",
          "@type": "Organization",
          image: "https://mistral.ai/images/logos/logo-mistral.svg",
          sameAs: [
            "https://en.wikipedia.org/wiki/Mistral_AI",
            "https://www.linkedin.com/company/mistralai",
            "https://github.com/mistralai",
            "https://x.com/mistralai",
            "https://huggingface.co/mistralai",
          ],
          slogan: "Mistral is #1 in Sovereign AI",
          address: { "@type": "PostalAddress", addressCountry: "FR", addressLocality: "Paris" },
          founders: [
            { name: "Arthur Mensch", "@type": "Person", jobTitle: "Co-founder and CEO" },
            { name: "Guillaume Lample", "@type": "Person", jobTitle: "Co-founder and Chief Science Officer" },
            { name: "Timothée Lacroix", "@type": "Person", jobTitle: "Co-founder and CTO" },
          ],
          legalName: "Mistral AI SAS",
          description:
            "Mistral is a French artificial intelligence company building open-weight frontier large language models, AI agents, and developer platforms. Headquartered in Paris, it combines open-weight and commercial models with inference infrastructure.",
          foundingDate: "2023-04",
          alternateName: "Mistral AI",
        },
        {
          "@id": "https://mistral.ai/#website",
          url: "https://mistral.ai/",
          name: "Mistral",
          "@type": "WebSite",
          publisher: { "@id": "https://mistral.ai/#organization" },
          inLanguage: "en",
        },
      ],
      "@context": "https://schema.org",
    })}></script>
    <ClientRouter fallback="animate" />
    <script is:inline>
      ;(function () {
        function applyTheme(doc) {
          try {
            var stored = localStorage.getItem('theme')
            var prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches
            // 'system' (or unset) follows the OS; 'dark'/'light' are explicit choices.
            var isDark = stored === 'dark' || ((stored === 'system' || stored === null) && prefersDark)
            if (isDark) {
              doc.documentElement.classList.add('dark')
            } else {
              doc.documentElement.classList.remove('dark')
            }
          } catch (e) {}
        }

        applyTheme(document)

        // The ClientRouter copies the incoming <html> attributes over the live ones, which
        // would drop the theme class until the darkmode button re-adds it. Apply the theme
        // to the incoming document so the class survives the swap without a flash.
        document.addEventListener('astro:before-swap', function (event) {
          applyTheme(event.newDocument)
        })
      })()
    </script>
  </head>
  <body>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-100 focus:px-4 focus:py-2 focus:rounded-md focus:bg-surface-brand-primary focus:text-text-primary focus:shadow-box"
      >Skip to content</a
    >
    <GlobalNavigation active={navActive} surface={navSurface} />
    <slot />
    <script type="module" src="/js/layout.astro_astro_type_script_index_0_lang.RiVFrrwj.js"></script>
  </body>
</html>
