---
// Static section markup, rendered on the server exactly as the original does.
// Behaviour comes from the vanilla-TS/GSAP modules loaded in Base.astro.
//
// The original marks the current section in two places: the header surface
// (`bg-surface-brand-secondary` on /research/, `…-primary` on /) and the active
// nav item (`bg-surface-brand-primary` added to its class list). Both are
// server-rendered, so they are props here rather than JS.
interface Props {
  active?: string
  surface?: 'primary' | 'secondary'
}

const { active = '', surface = 'primary' } = Astro.props
const headerClass = `fixed z-50 flex items-center justify-between dark:text-white transition-colors top-0 w-full left-0 border-b border-border-primary divide-x divide-border-primary bg-surface-brand-${surface}`
const navItemClass = (path: string) =>
  `nav-item-parent px-4 text-button-large h-12 flex items-center hover:bg-surface-brand-primary font-mistral transition-colors last:border-r border-border-primary${
    active === path ? ' bg-surface-brand-primary' : ''
  }`
import { route } from '../content/routes'
import LogoMistral from './svg/LogoMistral.astro'
import VibeHero01 from './svg/VibeHero01.astro'
import ArrowDownLeft from './svg/ArrowDownLeft.astro'
import ArrowUpRight from './svg/ArrowUpRight.astro'
import StudioCards03 from './svg/StudioCards03.astro'
