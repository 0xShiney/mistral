---
// Static section markup, rendered on the server exactly as the original does.
// Behaviour comes from the vanilla-TS/GSAP modules loaded in Base.astro.
import { route } from '../content/routes'
import { legalUrl } from '@mistral-clone/config'
import SocialLinkedin from './svg/SocialLinkedin.astro'
import SocialX from './svg/SocialX.astro'
import SocialYoutube from './svg/SocialYoutube.astro'
import SocialDiscord from './svg/SocialDiscord.astro'
import SocialReddit from './svg/SocialReddit.astro'
import BadgeAppStore from './svg/BadgeAppStore.astro'
import BadgeGooglePlay from './svg/BadgeGooglePlay.astro'
import FooterIllustration from './svg/FooterIllustration.astro'
import Globalfooter01 from './svg/Globalfooter01.astro'
import ThemeSystem from './svg/ThemeSystem.astro'
import ThemeLight from './svg/ThemeLight.astro'
import ThemeDark from './svg/ThemeDark.astro'
import ComputeInfra01 from './svg/ComputeInfra01.astro'
import InferenceHero04 from './svg/InferenceHero04.astro'
---

<global-footer><footer class="border-t border-border-primary flex flex-col divide-y md:divide-y-0 divide-border-primary"><div class="border-b border-border-primary"><div class="max-w-432 w-full mx-auto relative h-auto grid grid-cols-1 md:grid-cols-3 divide-y md:divide-y-0 md:divide-x divide-border-primary maxdesktop:border-x border-border-primary"><div class="flex flex-col gap-4 md:gap-6 px-4 py-6 md:px-6 md:py-10 "><h3 class="text-text-tertiary">Build with us</h3><ul class="flex flex-col md:gap-1"><li><a href={route('/customers/')} class="block py-3 md:py-0"><p class="text-h6 font-mistral text-text-primary hover:underline">Customers</p></a></li><li><a href={route('/partners/')} class="block py-3 md:py-0"><p class="text-h6 font-mistral text-text-primary hover:underline">Partners</p></a></li><li><a href={route('/brand/')} class="block py-3 md:py-0"><p class="text-h6 font-mistral text-text-primary hover:underline">Brand</p></a></li><li><a href={route('/pricing/')} class="block py-3 md:py-0"><p class="text-h6 font-mistral text-text-primary hover:underline">Pricing</p></a></li></ul></div><div class="flex flex-col gap-4 md:gap-6 px-4 py-6 md:px-6 md:py-10 "><h3 class="text-text-tertiary">Dive deeper</h3><ul class="flex flex-col md:gap-1"><li><a href={route('/solutions/coding/')} class="block py-3 md:py-0"><p class="text-h6 font-mistral text-text-primary hover:underline">Coding</p></a></li><li><a href={route('/solutions/document-ai/')} class="block py-3 md:py-0"><p class="text-h6 font-mistral text-text-primary hover:underline">Document intelligence</p></a></li><li><a href={route('/solutions/speech/')} class="block py-3 md:py-0"><p class="text-h6 font-mistral text-text-primary hover:underline">Speech</p></a></li><li><a href={route('/our-method/')} class="block py-3 md:py-0"><p class="text-h6 font-mistral text-text-primary hover:underline">Applied AI services</p></a></li><li><a href={route('/use-cases/')} class="block py-3 md:py-0"><p class="text-h6 font-mistral text-text-primary hover:underline">All use cases</p></a></li></ul></div><div class="flex flex-col gap-4 md:gap-6 px-4 py-6 md:px-6 md:py-10 "><h3 class="text-text-tertiary">Company</h3><ul class="flex flex-col md:gap-1"><li><a href={legalUrl('/terms')} class="block py-3 md:py-0"><p class="text-h6 font-mistral text-text-primary hover:underline">Terms of Service</p></a></li><li><a href={legalUrl('/terms/privacy-policy?language=en-US')} class="block py-3 md:py-0"><p class="text-h6 font-mistral text-text-primary hover:underline">Privacy Policy</p></a></li><li><mistral-atom-button-link-action class="block py-3 md:py-0" data-action="cookie-preferences" data-message-disabled="Cookies are disabled in your browser." data-message-blocked="Cookie preferences are blocked by your browser or an extension."><button type="button" class="js-trigger block w-full text-left cursor-pointer"><span class="text-h6 font-mistral block text-text-primary hover:underline">Privacy choices</span></button><p class="js-status mt-1 text-body-small text-text-tertiary" role="status" aria-live="polite" hidden></p></mistral-atom-button-link-action></li><li><a href={legalUrl('/terms/data-processing-addendum')} class="block py-3 md:py-0"><p class="text-h6 font-mistral text-text-primary hover:underline">Data processing agreement</p></a></li><li><a href="https://trust.mistral.ai/" target="_blank" rel="noopener noreferrer" class="block py-3 md:py-0"><p class="text-h6 font-mistral text-text-primary hover:underline">Trust Center</p></a></li><li><a href={route('/legal/')} class="block py-3 md:py-0"><p class="text-h6 font-mistral text-text-primary hover:underline">Legal notice</p></a></li></ul></div></div></div><div id="sub-footer" class="max-w-432 w-full mx-auto h-auto md:p-10 relative md:gap-32 flex flex-col justify-between items-center"><div class="md:flex justify-between items-center w-full"><nav aria-label="Social media" class="flex justify-center md:justify-start items-center p-4 md:p-0 gap-6 w-full border-b border-border-primary md:border-0"><a href="https://www.linkedin.com/company/mistralai/" aria-label="LinkedIn" class="text-button-small dark:text-white font-mistral flex items-center gap-1 hover:underline"><SocialLinkedin /></a><a href="https://x.com/mistralai" aria-label="X" class="text-button-small dark:text-white font-mistral flex items-center gap-1 hover:underline"><SocialX /></a><a href="https://www.youtube.com/@MistralAIOfficial" aria-label="YouTube" class="text-button-small dark:text-white font-mistral flex items-center gap-1 hover:underline"><SocialYoutube /></a><a href="https://discord.gg/mistralai" aria-label="Discord" class="text-button-small dark:text-white font-mistral flex items-center gap-1 hover:underline"><SocialDiscord /></a><a href="https://www.reddit.com/r/MistralAI/" aria-label="Reddit" class="text-button-small dark:text-white font-mistral flex items-center gap-1 hover:underline"><SocialReddit /></a></nav><div class="p-4 md:p-0 w-full flex flex-col items-center md:items-end border-b border-border-primary md:border-0"><p class="text-button-small font-mistral text-text-tertiary mb-2">Get Mistral Vibe</p><div class="flex gap-2 justify-end"><a href="https://apps.apple.com/us/app/le-chat-by-mistral-ai/id6740410176" aria-label="Download on the App Store" class="text-button-small hover:underline"><span class="relative inline-block w-32" aria-hidden="true"><BadgeAppStore /></span></a><a href="https://play.google.com/store/apps/details?id=ai.mistral.chat" aria-label="Get it on Google Play" class="text-button-small hover:underline"><span class="relative inline-block w-32" aria-hidden="true"><BadgeGooglePlay /></span></a></div></div></div><div class="px-4 md:px-0 pt-20 md:pt-0 md:absolute bottom-0 overflow-hidden flex items-end"><div id="footer-m" class="w-60 h-42 relative"><FooterIllustration /><span class="inline-block w-60 z-2 relative" aria-hidden="true"><Globalfooter01 />
</span></div></div><div class="p-4 md:p-0 flex justify-between items-end w-full border-t border-border-primary md:border-0"><p class="text-text-muted text-body-small">Mistral AI © 2026</p><div class="flex justify-end gap-2 items-center"><mistral-atom-button-darkmode class="flex items-center justify-center gap-1 border border-border-primary bg-surface-brand-secondary rounded-lg p-1" data-active-class="bg-surface-brand-primary outline outline-border-primary" role="group" aria-label="Theme"><button type="button" class="js-theme-option cursor-pointer shrink-0 flex items-center justify-center size-7 rounded hover:bg-surface-brand-primary" data-theme="system" aria-label="System theme" aria-pressed="true"><span class="relative inline-block w-4" aria-hidden="true"><ThemeSystem />
</span></button><button type="button" class="js-theme-option cursor-pointer shrink-0 flex items-center justify-center size-7 rounded hover:bg-surface-brand-primary" data-theme="light" aria-label="Light theme" aria-pressed="false"><span class="relative inline-block w-4" aria-hidden="true"><ThemeLight />
</span></button><button type="button" class="js-theme-option cursor-pointer shrink-0 flex items-center justify-center size-7 rounded hover:bg-surface-brand-primary" data-theme="dark" aria-label="Dark theme" aria-pressed="false"><span class="relative inline-block w-4" aria-hidden="true"><ThemeDark />
</span></button></mistral-atom-button-darkmode><global-language-switcher data-default-locale="en" data-non-default-locales="fr,it"><div class="group relative w-fit" data-state="close"><button type="button" class="js-trigger flex items-center rounded-md gap-2 px-3 py-2 border border-border-primary dark:text-white" aria-expanded="false" aria-controls="language-switcher-list" aria-label="English — change language"><p class="text-button-small font-mistral text-current js-label">English</p><span class="relative inline-block js-chevron w-4 transition-transform duration-300 group-data-[state=open]:rotate-180" aria-hidden="true"><ComputeInfra01 />
</span></button><ul id="language-switcher-list" class="js-list absolute bottom-full left-0 mb-2 hidden min-w-full w-max rounded-md border border-border-primary bg-surface-brand-primary text-text-primary shadow-xl overflow-hidden z-10" aria-label="Change language"><li class="js-option border-b border-border-primary last:border-0" data-value="en" data-selected="true"><button type="button" class="js-option-button cursor-pointer w-full flex items-center justify-between gap-2 px-3 py-2 text-left hover:bg-action-ghost-1" lang="en" aria-current="true"><p class="text-button-small font-mistral text-current">English</p><span class="relative inline-block js-check w-3" aria-hidden="true"><InferenceHero04 />
</span></button></li><li class="js-option border-b border-border-primary last:border-0" data-value="fr" data-selected="false"><button type="button" class="js-option-button cursor-pointer w-full flex items-center justify-between gap-2 px-3 py-2 text-left hover:bg-action-ghost-1" lang="fr"><p class="text-button-small font-mistral text-current">Français</p><span class="relative inline-block js-check w-3 opacity-0" aria-hidden="true"><InferenceHero04 />
</span></button></li><li class="js-option border-b border-border-primary last:border-0" data-value="it" data-selected="false"><button type="button" class="js-option-button cursor-pointer w-full flex items-center justify-between gap-2 px-3 py-2 text-left hover:bg-action-ghost-1" lang="it"><p class="text-button-small font-mistral text-current">Italiano</p><span class="relative inline-block js-check w-3 opacity-0" aria-hidden="true"><InferenceHero04 />
</span></button></li></ul></div></global-language-switcher></div></div></div></footer><div class="w-full h-64 relative overflow-hidden" aria-hidden="true"><div class="absolute z-3 left-12 right-12 border-x border-black/10 h-full"><div class="w-full h-20 border-b border-black/10"></div><div class="w-full h-20 border-b border-black/10"></div><div class="w-full h-20 border-b border-black/10"></div><div class="w-full h-20 border-b border-black/10"></div><div class="absolute right-0 top-0 aspect-square h-full"><div class="size-[200%] rounded-tl-[50%] border-black/10 border-l border-t"></div></div></div><img src="/images/footer/gradient.png" alt="gradient background" loading="lazy" decoding="async" class="absolute z-3 top-0 size-full object-cover opacity-20"><div class="size-full relative z-1"><div class="h-1/4 shrink w-full flex items-end bg-orange-medium"></div><div class="h-1/4 shrink w-full flex items-end bg-orange-strong"></div><div class="h-1/4 shrink w-full flex items-end bg-red-strong"><div class="max-w-250 w-full mx-auto px-12"><img src="/images/cat/cat-sitting-black.gif" alt="cat sitting" width="56" height="49" loading="lazy" decoding="async" class="w-14"></div></div><div class="h-1/4 shrink w-full flex items-end bg-red-contrast"></div></div></div></global-footer>
