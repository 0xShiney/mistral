{
  "name": "mistral-clone",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.9",
  "scripts": {
    "dev": "turbo run dev --parallel --ui tui",
    "dev:web": "pnpm --filter @mistral-clone/web dev",
    "dev:legal": "pnpm --filter @mistral-clone/legal dev",
    "build": "turbo run build",
    "preview": "turbo run preview --parallel",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "verify": "node scripts/verify.mjs",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "sync:assets": "pnpm --filter @mistral-clone/assets sync",
    "extract:legal": "pnpm --filter @mistral-clone/legal extract"
  },
  "devDependencies": {
    "turbo": "^2.5.6"
  }
}
